{
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/admin/upload/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/product-requests/upload/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/cron/expire-inbox/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/expire-inbox",
      "schedule": "0 10 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "zsmokeshop.com"
        }
      ],
      "destination": "https://www.zsmokeshop.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "zsmokeshop.com"
        }
      ],
      "destination": "https://www.zsmokeshop.com/:path*",
      "permanent": true
    }
  ]
}
