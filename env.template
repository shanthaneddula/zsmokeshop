# Environment Variables Template for Z Smoke Shop
# Copy this file to .env.local and fill in real values.
# Never commit secret values.

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://zsmokeshop.com

# Admin Authentication
# Production admin users live in Redis (zsmokeshop:users).
# Optional local/bootstrap login (used only if no Redis user matches):
ADMIN_USERNAME=admin
# bcrypt hash of the bootstrap admin password (generate with: node -e "require('bcryptjs').hash('your-password', 12).then(console.log)")
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash_here

# JWT Secret (generate a secure random string)
JWT_SECRET=your_jwt_secret_key_here

# Redis (preferred store for catalog, settings, orders, and users)
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@your-redis-host:6379

# Vercel KV (optional fallback if REDIS_URL is not set)
# Get these from the Vercel KV dashboard: https://vercel.com/docs/storage/vercel-kv
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token

# Vercel Blob (usually injected when a Blob store is linked on Vercel)
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token

# Resend Email Service (for order notifications)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=orders@zsmokeshop.com

# Twilio SMS Service (optional - for SMS notifications)
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15125551234

# Store Contact Information (used in SMS/email copy)
STORE_PHONE_WILLIAM_CANNON=+15125551234
STORE_PHONE_CAMERON_RD=+15125551234
STORE_EMAIL_WILLIAM_CANNON=williamcannon@zsmokeshop.com
STORE_EMAIL_CAMERON_RD=cameron@zsmokeshop.com

# Optional
CRON_SECRET=your_cron_secret_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Node Environment
NODE_ENV=development
